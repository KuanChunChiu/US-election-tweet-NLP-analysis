            "2024 tweet dataset:\n",
            "(12566,) (3142,) (12566,) (3142,)\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "tfidf_vectorizer_20 = TfidfVectorizer(max_features=10000, ngram_range=(1, 2), stop_words=\"english\")\n",
        "tfidf_train_20 = tfidf_vectorizer_20.fit_transform(X_train_tfidf_20)\n",
        "tfidf_test_20 = tfidf_vectorizer_20.transform(X_test_tfidf_20)\n",
        "\n",
        "tfidf_vectorizer_24 = TfidfVectorizer(max_features=10000, ngram_range=(1, 2), stop_words=\"english\")\n",
        "tfidf_train_24 = tfidf_vectorizer_24.fit_transform(X_train_tfidf_24)\n",
        "tfidf_test_24 = tfidf_vectorizer_24.transform(X_test_tfidf_24)\n",
        "\n",
        "print (\"2020 tweet training and testing embedding shape:\")\n",
        "print (tfidf_train_20.shape, tfidf_test_20.shape)\n",
        "print (\"\\n2024 tweet training and testing embedding shape:\")\n",
        "print (tfidf_train_24.shape, tfidf_test_24.shape)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "fQsx2U6DxAAQ",
        "outputId": "7be201c6-86ad-4121-fe21-f5614bfb0f64"
