      "cell_type": "markdown",
      "source": [
        "### DistilBERT approach"
      ],
      "metadata": {
        "id": "BPL_vVDf9N1U"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "num_classes = len(tweet_2020_df[\"label\"].unique())\n",
        "bert_tokenizer = AutoTokenizer.from_pretrained(\"distilbert-base-uncased\")\n",
        "bert_model = AutoModelForSequenceClassification.from_pretrained(\"distilbert-base-uncased\", num_labels=num_classes)\n",
        "\n",
        "if torch.cuda.is_available():\n",
        "  print (\"Using GPU\")\n",
        "  bert_model.to(\"cuda\")\n",
        "else:\n",
        "  print (\"Using CPU\")\n",
        "  bert_model.to(\"cpu\")"
