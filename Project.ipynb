      "cell_type": "markdown",
      "source": [
        "### TF-IDF embedding + logistic regression approach"
      ],
      "metadata": {
        "id": "_b8enqirCBHo"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "tweets_2020 = tweet_2020_df[\"text\"]\n",
        "labels_2020 = tweet_2020_df[\"label\"]\n",
        "tweets_2024 = tweet_2024_df[\"text\"]\n",
        "labels_2024 = tweet_2024_df[\"label\"]\n",
        "\n",
        "X_train_tfidf_20, X_test_tfidf_20, y_train_tfidf_20, y_test_tfidf_20 = train_test_split(tweets_2020, labels_2020, test_size=0.2)\n",
        "X_train_tfidf_24, X_test_tfidf_24, y_train_tfidf_24, y_test_tfidf_24 = train_test_split(tweets_2024, labels_2024, test_size=0.2)\n",
        "\n",
        "print (\"2020 tweet dataset:\")\n",
        "print (X_train_tfidf_20.shape, X_test_tfidf_20.shape, y_train_tfidf_20.shape, y_test_tfidf_20.shape)\n",
        "print (\"\\n2024 tweet dataset:\")\n",
        "print (X_train_tfidf_24.shape, X_test_tfidf_24.shape, y_train_tfidf_24.shape, y_test_tfidf_24.shape)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "QE0gWDh0w_9o",
        "outputId": "cd2aa8f3-2701-458e-faa5-a8a44f44aa82"
      },
